---
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout title="Legacy logo unavailable">
  <section class="not-found">
    <p class="eyebrow">Migration notice</p>
    <h1>This legacy logo is unavailable</h1>
    <p>
      The original listing had no asset that passed the static registry’s format, availability,
      size, and SVG safety checks. Its legacy URL is preserved here rather than silently returning
      a missing page.
    </p>
    <a class="button button--primary" href="/">Browse published logos</a>
  </section>
</BaseLayout>
