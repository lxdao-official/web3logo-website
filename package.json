{
  "name": "web3logo-static",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0 <11"
  },
  "scripts": {
    "dev": "astro dev",
    "generate": "node scripts/generate-static.mjs",
    "validate": "node scripts/validate-content.mjs && node scripts/generate-static.mjs --check && astro check",
    "test": "vitest run && python3 -m unittest scripts/import_legacy_test.py",
    "prebuild": "pnpm generate",
    "build": "astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
